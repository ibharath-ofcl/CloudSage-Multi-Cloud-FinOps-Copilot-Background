# ==============================================================================
# CloudSage Local Development Environment Configuration
# Copy this file to .env for local development with docker compose or native run.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="CloudSage - Multi-Cloud FinOps Copilot"
ENVIRONMENT=development
API_V1_STR=/api/v1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudsage
DATABASE_URL=
SYNC_DATABASE_URL=

# Redis & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & RBAC
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY=development-secret-key-change-in-production-stage
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=cloudsage-auth
JWT_AUDIENCE=cloudsage-api
ALLOW_DEV_AUTH_HEADERS=true
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
SESSION_INACTIVITY_TIMEOUT_MINUTES=60
REQUIRE_DUAL_APPROVAL_FOR_SUPER_ADMIN=true

# AI FinOps Copilot (Advisory Mode)
COPILOT_ENABLED=true
COPILOT_PROVIDER=auto
COPILOT_MODEL_NAME=gpt-4o-mini
COPILOT_API_KEY=
COPILOT_API_ENDPOINT=
COPILOT_DEMO_MODE=true

# CORS & Frontend Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]

# Notifications & Alerts
NOTIFICATION_SAFE_LOCAL_MODE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=alerts@cloudsage.internal
